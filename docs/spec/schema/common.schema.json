{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iris:model:1:common",
  "title": "Iris open model 1: common definitions",
  "description": "Definitions that each form schema uses. See docs/spec/01-mirror-store-forms.md, section 6.1.",
  "$defs": {
    "messageId": {
      "type": "string",
      "pattern": "^m-[1-9][0-9]*$"
    },
    "threadId": {
      "type": "string",
      "pattern": "^t-[1-9][0-9]*$"
    },
    "senderId": {
      "type": "string",
      "pattern": "^p-[1-9][0-9]*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "utcDateTime": {
      "$comment": "A date-time in UTC with three digits of milliseconds and Z, as the engine writes it. See docs/spec/03-job-workspace.md, section 2.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "money": {
      "type": "object",
      "required": [
        "value",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "party": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "self",
            "sender"
          ]
        },
        "sender": {
          "$ref": "#/$defs/senderId"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "format": "email"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "sender"
          }
        }
      },
      "then": {
        "required": [
          "sender"
        ]
      }
    },
    "source": {
      "type": "object",
      "required": [
        "message",
        "thread",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "$ref": "#/$defs/messageId"
        },
        "thread": {
          "$ref": "#/$defs/threadId"
        },
        "role": {
          "enum": [
            "origin",
            "update",
            "evidence"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "if": {
        "properties": {
          "role": {
            "const": "origin"
          }
        }
      },
      "then": {
        "required": [
          "quote"
        ]
      }
    },
    "derived": {
      "type": "object",
      "required": [
        "by"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "rule",
            "model",
            "person"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "by": {
                "const": "rule"
              }
            }
          },
          "then": {
            "required": [
              "rule"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "by": {
                "const": "model"
              }
            }
          },
          "then": {
            "required": [
              "model",
              "prompt"
            ]
          }
        }
      ]
    },
    "attention": {
      "description": "The attention of the item. See docs/spec/02-changeset-policy-ledger.md, section 6.4.",
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "shown",
            "bundled",
            "hidden"
          ]
        },
        "rule": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "item": {
      "description": "The fields of each item of each form.",
      "type": "object",
      "required": [
        "model",
        "id",
        "form",
        "status",
        "title",
        "sources",
        "created",
        "updated",
        "derived"
      ],
      "properties": {
        "model": {
          "type": "string", "pattern": "^iris/1\\.(0|[1-9][0-9]*)$"
        },
        "id": {
          "type": "string"
        },
        "form": {
          "enum": [
            "commitment",
            "conversation",
            "record",
            "feed",
            "signal"
          ]
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          },
          "contains": {
            "properties": {
              "role": {
                "const": "origin"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "created": {
          "$ref": "#/$defs/dateTime"
        },
        "updated": {
          "$ref": "#/$defs/dateTime"
        },
        "derived": {
          "$ref": "#/$defs/derived"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matter": {
          "description": "The g- ID of the confirmed matter of the item, or null. See docs/specs/2026-11-16-matters.md.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^g-[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attention": {
          "$ref": "#/$defs/attention"
        }
      },
      "if": {
        "properties": {
          "derived": {
            "properties": {
              "by": {
                "const": "person"
              }
            },
            "required": [
              "by"
            ]
          }
        },
        "required": [
          "derived"
        ]
      },
      "then": {
        "not": {
          "required": [
            "confidence"
          ]
        }
      }
    }
  }
}
