{
  "permissions": {
    "allow": [
      "Bash(scripts/local-ci/run.sh)",
      "Bash(scripts/local-ci/run.sh:*)",
      "Bash(python3 scripts/review/review.py:*)",
      "Bash(python3 scripts/release/release.py notes)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/local-ci/session-start.sh"
          }
        ]
      }
    ]
  }
}
