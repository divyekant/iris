# Deploy: runs on each push to main (a release merge) and by hand.
# This product has no deploy steps yet. Add them below and document them in
# docs/DEPLOYMENT.md. Keep production secrets in GitHub environment secrets.
name: deploy
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: deploy
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - name: Deploy
        run: echo "No deploy steps yet. Add them in .github/workflows/deploy.yml (docs/DEPLOYMENT.md)."
