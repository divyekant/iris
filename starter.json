{
  "version": 1,
  "product": "iris",
  "base": "develop",
  "release": {
    "branch": "main"
  },
  "review": {
    "model": "gpt-6-sol",
    "effort": "medium",
    "merge_method": "squash",
    "trusted_authors": [
      "divyekant"
    ]
  },
  "always": [
    "starter.json",
    "scripts/local-ci/**"
  ],
  "areas": {
    "engine": {
      "paths": [
        "crates/**",
        "scripts/install.sh",
        "docs/spec/schema/**",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".cargo/**"
      ],
      "setup": "cargo fetch --locked",
      "setup_inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ],
      "check": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
      "test": "cargo test --workspace --locked",
      "tools": [
        "rustc --version",
        "cargo --version"
      ],
      "env": {
        "RUSTUP_HOME": "~/.rustup",
        "CARGO_HOME": "./.local-ci/cargo"
      }
    },
    "client": {
      "paths": [
        "client/**",
        ".kalos.yaml"
      ],
      "setup": "cd client && npx --yes pnpm@10.28.0 install --frozen-lockfile && npx playwright-core install --only-shell chromium",
      "setup_inputs": [
        "client/package.json",
        "client/pnpm-lock.yaml",
        "client/.npmrc"
      ],
      "check": "cd client && npm run lint",
      "test": "cd client && npm test",
      "tools": [
        "node --version",
        "npm --version"
      ]
    },
    "mac": {
      "paths": [
        "apps/mac/**"
      ],
      "setup": "cd apps/mac && cargo fetch --locked",
      "setup_inputs": [
        "apps/mac/Cargo.toml",
        "apps/mac/Cargo.lock",
        "rust-toolchain.toml"
      ],
      "check": "cd apps/mac && cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings",
      "test": "cd apps/mac && cargo test --locked",
      "tools": [
        "rustc --version",
        "cargo --version"
      ],
      "env": {
        "RUSTUP_HOME": "~/.rustup",
        "CARGO_HOME": "./.local-ci/cargo"
      }
    },
    "spec-kit": {
      "paths": [
        "docs/spec/schema/**",
        "docs/spec/conformance/**",
        "docs/spec/VERSION"
      ],
      "setup": "python3 -m venv .local-ci/spec-venv && .local-ci/spec-venv/bin/pip install --quiet --require-hashes -r docs/spec/conformance/requirements.txt",
      "setup_inputs": [
        "docs/spec/conformance/requirements.txt"
      ],
      "check": ".local-ci/spec-venv/bin/python -m py_compile docs/spec/conformance/run.py docs/spec/conformance/producer/produce.py",
      "test": ".local-ci/spec-venv/bin/python -m unittest discover -s docs/spec/conformance -p 'test_*.py' -v",
      "tools": [
        "python3 --version"
      ]
    },
    "site": {
      "paths": [
        "docs/*.html",
        "docs/guide/**",
        "docs/site.css",
        "docs/spec/schema/**",
        "docs/spec/VERSION",
        "scripts/site/**"
      ],
      "check": "python3 -m py_compile scripts/site/test_site.py",
      "test": "python3 -m unittest discover -s scripts/site -v",
      "tools": [
        "python3 --version"
      ]
    },
    "probes": {
      "paths": [
        "scripts/probes/**"
      ],
      "check": "python3 -m py_compile scripts/probes/macos-sandbox-probe.py",
      "test": "python3 scripts/probes/macos-sandbox-probe.py --self-check",
      "tools": [
        "python3 --version"
      ]
    }
  },
  "cloud": {
    "profile": true,
    "keys": [],
    "apt": [
      "bubblewrap"
    ],
    "hosts": [
      "crates.io",
      "index.crates.io",
      "static.crates.io",
      "static.rust-lang.org",
      "registry.npmjs.org",
      "github.com",
      "pypi.org",
      "files.pythonhosted.org"
    ]
  },
  "board": "https://claude.ai/artifact/VWqsmpqHNgiop14TpoecjV"
}
